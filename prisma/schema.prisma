generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  USER
  ADMIN
  MEMBER
}

enum ChangeType {
  USERNAME
  LEFT
  REMOVED
}

enum Chat {
  DM
  GROUP
  YOU
}

enum MediaFormat {
  DOC
  LINK
  MEDIA
}

model User {
  id          String    @id @default(uuid())

  // The Clerk user ID — the bridge between Clerk and your DB
  // This is set once when the Clerk webhook fires on user.created
  clerkId     String    @unique @map("clerk_id")

  email       String    @unique
  username    String    @unique

  // Profile fields — owned and managed by YOUR application
  name        String?
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  lastSeenAt  DateTime? @map("last_seen_at")
  isVerified  Boolean   @default(false) @map("is_verified")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  conversations ConversationMember[]
  // sentMessages  Message[]

  @@map("users")
}

model ConversationMember {
  id             String        @id @default(uuid())
  conversationId String        @map("conversation_id")
  conversation   Conversation  @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  userId         String        @map("user_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole    @default(MEMBER)
  joinedAt       DateTime      @default(now()) @map("joined_at")
  lastReadAt     DateTime?     @map("last_read_at")

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Media {
  id             String        @id @default(uuid())
  mediaType      MediaFormat[] @map("media_type")
  content        String
  messageId      String        @unique @map("message_id")
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)

  @@map("media")
}

model MemberChange {
  id             String        @id @default(uuid())
  changeType     ChangeType    @map("change_type")
  change         String        @db.VarChar(30)
  conversationId String?       @map("conversation_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)
  createdAt      DateTime      @default(now()) @map("created_at")
  expiresAt      DateTime      @map("expires_at")

  @@map("member_changes")
}

model Conversation {
  conversationId     String               @id @default(uuid()) @map("conversation_id")
  name               String?              @db.VarChar(100)
  type               Chat                 @default(DM)
  image              String?
  description        String?              @db.VarChar(200)
  dmKey              String?              @unique @map("dm_key")
  advancedPrivacy    Boolean              @default(false) @map("advanced_privacy")
  lastActivityAt     DateTime             @default(now()) @map("last_activity_at")
  lastMessagePreview String?              @map("last_message_preview")

  members            ConversationMember[]
  changes            MemberChange[]
  allMedia           Media[]

  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  @@index([lastActivityAt(sort: Desc)])
  @@map("conversations")
}